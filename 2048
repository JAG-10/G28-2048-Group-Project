#include <iostream>
#include <fstream>
#include <string>
#include <ctime>
#include "2048_helper.h"
using namespace std;
#ifndef WITH_SAVE_LOAD
#define WITH_SAVE_LOAD
#endif
#ifdef WITH_SAVE_LOAD
bool save_game(const GameState &game, const char *filename)
{
	ofstream out(filename);
	if (!out)
		return false;
	out << "2048save v1\n";
	out << game.score << " " << game.moves << " " << (game.won ? 1 : 0) << "\n";
	for (int r = 0; r < BOARD_SIZE; r++)
		for (int c = 0; c < BOARD_SIZE; c++)
			out << game.board[r][c] << (c + 1 < BOARD_SIZE ? ' ' : '\n');
	return out.good();
}
bool is_valid_tile(int v)
{
	return v == 0 || (v >= 2 && (v & (v - 1)) == 0);
}
bool load_game(GameState &game, const char *filename)
{
	ifstream in(filename);
	if (!in)
		return false;
	string tag, version;
	in >> tag >> version;
	if (!in || tag != "2048save" || version != "v1")
		return false;
	int score, moves, won;
	in >> score >> moves >> won;
	if (!in || score < 0 || moves < 0 || (won != 0 && won != 1))
		return false;
	int tmp[BOARD_SIZE][BOARD_SIZE];
	for (int r = 0; r < BOARD_SIZE; r++)
		for (int c = 0; c < BOARD_SIZE; c++)
		{
			if (!(in >> tmp[r][c]))
				return false;
			if (!is_valid_tile(tmp[r][c]))
				return false;
		}
	copy_board(game.board, tmp);
	game.score = score;
	game.moves = moves;
	game.won = (won == 1);
	return true;
}
#endif
void print_menu()
{
	cout << "\n========= 2048 (5x5) =========\n"
		 << " 1. New game\n"
		 << " 2. Load saved game\n"
		 << " 3. Save current game\n"
		 << " 4. Quit\n"
		 << "==============================\n"
		 << "Choice (1-4): ";
}
void play_game(GameState &game)
{
	while (true)
	{
		print_board(game.board);
		cout << "  Score: " << game.score << "   Moves: " << game.moves << endl;
		if (highest_tile(game.board) >= WIN_TILE && !game.won)
		{
			game.won = true;
			cout << "\n*** You reached " << WIN_TILE << " - you win! ***\n"
				 << "Keep playing? (y/n): ";
			char ans;
			if (!(cin >> ans) || lower(ans) != 'y')
				return;
		}
		if (!can_move(game.board))
		{
			cout << "\n*** Game over - no moves left. Final score: "
				 << game.score << " ***\n";
			return;
		}
		cout << "\nMove? (U=up L=left D=down R=right, M=menu, E=quit) ";
		char cmd;
		if (!(cin >> cmd))
			return;
		cmd = lower(cmd);
		if (cmd == 'e' || cmd == 'm')
			return;
		int before[BOARD_SIZE][BOARD_SIZE];
		copy_board(before, game.board);
		int points = 0;
		switch (cmd)
		{
			case 'u': points = move_up(game.board);    break;
			case 'l': points = move_left(game.board);  break;
			case 'd': points = move_down(game.board);  break;
			case 'r': points = move_right(game.board); break;
			default:
				cout << "  Please use U, D, L or R.\n";
				continue;
		}
		if (boards_equal(before, game.board))
		{
			cout << "  Nothing moves that way.\n";
			continue;
		}
		game.score += points;
		game.moves++;
		insert_random(game.board);
	}
}
int main_game()
{
	GameState game;
	new_game(game);
#ifdef WITH_SAVE_LOAD
	bool has_game = false;
#endif
	while (true)
	{
		print_menu();
		int choice;
		if (!(cin >> choice))
		{
			if (cin.eof())
				return 0;
			cin.clear();
			cin.ignore(10000, '\n');
			cout << "  Enter a number 1-4.\n";
			continue;
		}
		switch (choice)
		{
			case 1:
				new_game(game);
#ifdef WITH_SAVE_LOAD
				has_game = true;
#endif
				play_game(game);
				break;
			case 2:
#ifdef WITH_SAVE_LOAD
				if (load_game(game, SAVE_FILE))
				{
					has_game = true;
					cout << "  Game loaded from '" << SAVE_FILE << "'.\n";
					play_game(game);
				}
				else
				{
					cout << "  Could not load '" << SAVE_FILE
						 << "' - the active game was NOT changed.\n";
				}
#else
				cout << "  Save/load is disabled in this build "
					 << "(compile with -DWITH_SAVE_LOAD to enable it).\n";
#endif
				break;
			case 3:
#ifdef WITH_SAVE_LOAD
				if (!has_game)
				{
					cout << "  No game in progress - start or load a game first.\n";
					break;
				}
				if (save_game(game, SAVE_FILE))
					cout << "  Game saved to '" << SAVE_FILE << "'.\n";
				else
					cout << "  Could not write '" << SAVE_FILE << "'.\n";
#else
				cout << "  Save/load is disabled in this build "
					 << "(compile with -DWITH_SAVE_LOAD to enable it).\n";
#endif
				break;
			case 4:
				cout << "  Goodbye!\n";
				return 0;
			default:
				cout << "  Enter a number 1-4.\n";
		}
	}
}
int main()
{
	srand((unsigned)time(0));
	return main_game();
}
