#include <iostream>
#include "2048_helper.h"
using namespace std;

int move_up(int board[][5], int numrows = 5)
{
    int points = 0;
    for (int col = 0; col < BOARD_SIZE; col++)
    {
        int line[BOARD_SIZE];
        for (int row = 0; row < numrows; row++)
            line[row] = board[row][col];                    

        points += slide_and_merge(line, numrows);

        for (int row = 0; row < numrows; row++)
            board[row][col] = line[row];
    }
    return points;
}

int move_down(int board[][5], int numrows = 5)
{
    int points = 0;
    for (int col = 0; col < BOARD_SIZE; col++)
    {
        int line[BOARD_SIZE];
        for (int row = 0; row < numrows; row++)
            line[row] = board[numrows - 1 - row][col];      

        points += slide_and_merge(line, numrows);

        for (int row = 0; row < numrows; row++)
            board[numrows - 1 - row][col] = line[row];
    }
    return points;
}
int move_left(int board[][5], int numrows = 5)
{
    int points = 0;
    for (int row = 0; row < numrows; row++)
    {
        int line[BOARD_SIZE];
        for (int col = 0; col < BOARD_SIZE; col++)
            line[col] = board[row][col];

        points += slide_and_merge(line, BOARD_SIZE);

        for (int col = 0; col < BOARD_SIZE; col++)
            board[row][col] = line[col];
    }
    return points;
}

int move_right(int board[][5], int numrows = 5)
{
    int points = 0;
    for (int row = 0; row < numrows; row++)
    {
        int line[BOARD_SIZE];
        for (int col = 0; col < BOARD_SIZE; col++)
            line[col] = board[row][BOARD_SIZE - 1 - col];   

        points += slide_and_merge(line, BOARD_SIZE);

        for (int col = 0; col < BOARD_SIZE; col++)
            board[row][BOARD_SIZE - 1 - col] = line[col];   
    }
    return points;
}


int main()
{
	int size = 5;
	int board[5][5] = {
		{0, 4, 2, 4, 0},
		{0, 0, 0, 0, 0},
		{2, 0, 2, 0, 2},
		{0, 0, 2, 0, 0},
		{2, 2, 2, 2, 2},
	};
	//while getch == x loop for up down left right

	cout << "Initial Board : [5x5] :" << endl;
	print_board(board);

	char choice = 'u';	//initialized
	while (choice != 'e')
	{

		cout << "Please enter choice:{u,d,l,r,e} for UP, DOWN, LEFT, RIGHT, Exit: " << endl;
		cout << "Choice: ";
		cin >> choice;

		if (choice == 'e')
            break;
        int before[5][5];
        copy_board(before, board);

		if (choice == 'u')
			move_up(board, size);
		else if (choice == 'd')
			move_down(board, size);
		else if (choice == 'l')
			move_left(board, size);
		else if (choice == 'r')
			move_right(board, size);

		insert_random(board, size);
		print_board(board);

	}


	return 0;
}







